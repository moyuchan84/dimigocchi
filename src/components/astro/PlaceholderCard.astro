---
/**
 * "이 영역은 아직 구현 전" 임을 알리는 안내 카드.
 *
 * P1 은 라우팅/레이아웃 골격만 만든다. 각 화면에서 실제 기능이 들어설 자리에 이 카드를 놓고,
 * 어느 Phase 에서 무엇이 구현되는지(관련 UC/FR 번호 포함) 명시한다.
 *
 * ── 마크업 규칙 ──
 *  - 제목 태그(h1~h6)를 쓰지 않는다. h1 은 PageHeader, h2 는 페이지 본문이 담당한다.
 *  - 카드 자체는 랜드마크가 아니므로 `<section>` 이 아닌 `<div>` 로 렌더한다.
 *  - 실제로 동작하지 않는 버튼/입력을 넣지 않는다(슬롯에도 넣지 말 것).
 */
import Badge from '@components/astro/Badge.astro';

interface Props {
	phase: 'P2' | 'P3' | 'P4' | 'P5' | 'P6' | 'P7';
	title?: string;
	uc?: string;
	fr?: string;
}

const { phase, title = '준비 중', uc, fr } = Astro.props;

/** "UC-02 · FR-2.1 ~ FR-2.4" 형태. 둘 다 없으면 표기 자체를 생략한다. */
const refLabel = [uc, fr].filter(Boolean).join(' · ');
---

<div class="rounded-lg border border-dashed border-slate-300 bg-white p-4 sm:p-5">
	<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
		<Badge variant="phase">{phase}</Badge>
		<span class="font-semibold text-slate-900">{title}</span>
		{refLabel && <span class="ml-auto font-mono text-xs text-slate-500">{refLabel}</span>}
	</div>
	<div class="placeholder-body mt-2 text-sm leading-relaxed text-slate-600">
		<slot />
	</div>
</div>

<style>
	/*
	 * 슬롯으로 넘어온 콘텐츠는 부모 컴포넌트 쪽에서 스코프되므로,
	 * 이 컴포넌트의 스코프 클래스를 기준으로 :global() 자손 선택자를 써야 적용된다.
	 * Tailwind 유틸리티(@apply)를 쓰지 않고 테마 변수로 동일한 값을 직접 지정했다.
	 */
	.placeholder-body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		/* Tailwind v4 는 사용된 테마 변수만 내보내므로, 스코프드 스타일에서는 폴백 값을 함께 적는다. */
		background-color: var(--color-slate-100, oklch(96.8% 0.007 247.896));
		color: var(--color-slate-800, oklch(27.9% 0.041 260.031));
		padding: 0.125rem 0.25rem;
		border-radius: 0.25rem;
	}

	.placeholder-body :global(p + p) {
		margin-top: 0.5rem;
	}
</style>
