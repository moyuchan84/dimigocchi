---
/**
 * 사이트 공통 헤더 — 브랜드 / 주 내비 / D-day 칩 / 검색 / 모바일 드로어.
 *
 * ── 설계 메모 ──
 * 1. props 가 없다. 활성 내비 표시는 `Astro.url.pathname` 으로 자동 판정하므로,
 *    페이지가 `activeNav` 같은 prop 을 넘기는 것을 잊어 활성 표시가 사라지는 사고가 없다.
 * 2. React 아일랜드를 쓰지 않는다. 드로어는 네이티브 `<details>` 로 구현했고,
 *    이 사이트는 MPA(정적 다중 페이지)이므로 **링크 클릭 = 새 문서 로드**다.
 *    즉 라우트가 바뀌면 드로어 상태가 저절로 초기화되며,
 *    SPA 에서 필요한 "라우트 변경 시 드로어 닫기" 로직이 아예 필요 없다.
 * 3. NavLinks 가 desktop/mobile 두 벌 렌더되어 DOM 에는 링크가 중복 존재하지만,
 *    `hidden`(display:none) 쪽은 접근성 트리에서 제거되므로 스크린리더가 두 번 읽지 않는다.
 * 4. `<summary>` 에 `aria-expanded` 를 수동으로 붙이지 않는다. 브라우저가 `<details>` 의
 *    확장 상태를 네이티브로 노출하며, 수동 속성은 열고 닫을 때 동기화가 깨진다.
 * 5. 드로어가 열린 동안의 배경 스크롤 잠금은 `global.css` 의
 *    `body:has(#site-nav-drawer[open])` 규칙이 JS 없이 처리한다.
 */
import { getEntry } from 'astro:content';

import Badge from '@components/astro/Badge.astro';
import NavLinks from '@components/astro/NavLinks.astro';
import { SITE_NAME, SITE_TAGLINE } from '@lib/navigation';

const pathname = Astro.url.pathname;

/**
 * D-day 칩용 일정 이벤트. 헤더는 모든 페이지에 렌더되므로 여기서 읽어도 페이지별 중복 fetch가
 * 아니다(Astro 는 정적 빌드 시 각 페이지 렌더마다 한 번씩 호출하지만 콘텐츠 컬렉션 조회는 가볍다).
 */
const schedule = await getEntry('schedule', '2027');
const scheduleEvents = schedule?.data.events ?? [];
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6 lg:px-8">
		<a href="/" class="flex shrink-0 items-baseline gap-2 rounded-md">
			<span class="text-base font-bold whitespace-nowrap text-brand-700 sm:text-lg">{SITE_NAME}</span>
			{/* 태그라인은 xl 이상에서만. md~lg 구간에서는 내비 6개를 넣을 폭이 나오지 않는다. */}
			<span class="hidden text-xs whitespace-nowrap text-slate-500 xl:inline">{SITE_TAGLINE}</span>
		</a>

		{/*
			데스크톱 주 내비 — lg(1024px) 이상에서만 가로로 편다.
			한글 라벨 6개의 자연 폭 합이 약 539px 라서 md(768px) 구간에서는
			브랜드·검색과 함께 한 줄에 들어가지 않는다(약 750px 필요 > 720px 가용).
			따라서 1024px 미만은 햄버거 드로어가 담당한다.
			모바일에서는 이 nav 가 display:none 이라 아래 우측 묶음이 ml-auto 를 이어받는다.
		*/}
		<nav aria-label="주 메뉴" class="ml-auto hidden lg:block">
			<NavLinks variant="desktop" pathname={pathname} />
		</nav>

		{/*
			우측 묶음. 모바일(lg 미만)에서는 데스크톱 nav 가 사라지므로 여기서 ml-auto 로
			오른쪽 끝에 붙이고, lg 이상에서는 nav 가 이미 ml-auto 를 가지므로 ml-0 으로 되돌린다.
			(auto 마진이 두 개면 남는 공간이 양쪽으로 나뉘어 배치가 어긋난다.)
		*/}
		<div class="ml-auto flex shrink-0 items-center gap-1 lg:ml-0">
			{/*
				D-day 칩 (UC-06 / FR-6.3). 헤더는 React 아일랜드를 쓰지 않으므로(설계 메모 2번)
				아래 is:inline 스크립트가 순수 JS로 계산해 텍스트를 갈아끼운다.
				서버 렌더 초기값은 "일정 미확정" 상태 — 지금은 모든 이벤트 date 가 "미정"이라
				스크립트가 아무 것도 바꾸지 않고 이 값 그대로 남는다(CLS 없음).
			*/}
			<a
				href="/guide/schedule"
				id="dday-chip"
				class="hidden items-center gap-2 rounded-full border border-slate-200 px-3 py-1.5 whitespace-nowrap hover:bg-slate-50 xl:flex"
			>
				<Badge variant="tentative" size="sm" class="dday-chip-badge">예정(가안)</Badge>
				<span class="dday-chip-label text-xs text-slate-600">2027 전형 일정</span>
			</a>
			<script
				type="application/json"
				id="dday-chip-events"
				set:html={JSON.stringify(scheduleEvents)}
			/>

			{/*
				검색 (UC-08). xl 이상은 실제 입력 가능한 GET 폼 — 제출 시 `/search?q=...` 로 이동하면
				SiteSearch(React 아일랜드)가 그 쿼리로 즉시 검색을 시작한다(JS 없이도 결과 페이지까지는
				도달하므로 점진적 향상). xl 미만은 폭이 부족해 기존처럼 아이콘 링크만 둔다.
				D-day 칩과 같은 이유로 두 벌을 렌더하고 하나를 숨긴다(NavLinks 의 desktop/mobile 패턴).
			*/}
			<form action="/search" method="get" class="hidden items-center xl:flex">
				<label for="header-search-input" class="sr-only">검색어</label>
				<div class="flex items-center gap-1.5 rounded-md border border-slate-200 py-1 pr-1 pl-2.5 focus-within:border-brand-400">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-4 w-4 shrink-0 text-slate-400"
						aria-hidden="true"
					>
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-3.6-3.6"></path>
					</svg>
					<input
						id="header-search-input"
						name="q"
						type="search"
						placeholder="검색"
						class="w-28 border-0 bg-transparent p-0 text-sm text-slate-700 placeholder:text-slate-400 focus:ring-0 focus:outline-none"
					/>
				</div>
			</form>
			<a
				href="/search"
				aria-label="검색"
				class="flex items-center gap-1.5 rounded-md px-2 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-brand-700 xl:hidden"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-5 w-5"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m20 20-3.6-3.6"></path>
				</svg>
				<span class="hidden sm:inline">검색</span>
			</a>

			<details id="site-nav-drawer" class="relative lg:hidden">
				<summary
					class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-slate-700 [&::-webkit-details-marker]:hidden"
				>
					<span class="sr-only">메뉴 열기/닫기</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="h-6 w-6"
						aria-hidden="true"
					>
						<path d="M4 6h16"></path>
						<path d="M4 12h16"></path>
						<path d="M4 18h16"></path>
					</svg>
				</summary>
				<nav
					aria-label="주 메뉴"
					class="fixed inset-x-0 top-16 z-40 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-slate-200 bg-white p-4 shadow-lg"
				>
					<NavLinks variant="mobile" pathname={pathname} />
				</nav>
			</details>
		</div>
	</div>
</header>

{/* ESC 로 드로어 닫기. is:inline 이라 번들링/하이드레이션 없이 그대로 인라인 삽입된다. */}
<script is:inline>
	document.addEventListener('keydown', function (event) {
		if (event.key !== 'Escape') return;
		var drawer = document.getElementById('site-nav-drawer');
		if (!drawer || !drawer.open) return;
		drawer.open = false;
		var summary = drawer.querySelector('summary');
		if (summary) summary.focus();
	});
</script>

{/*
	검색 단축키(FR-8.4). Header 는 React 아일랜드가 없으므로(설계 메모 2번) is:inline 순수 JS로.
	Ctrl/Cmd+K 는 포커스 위치와 무관하게 항상 가로챈다(커맨드 팔레트 관행). '/' 는 입력 요소에
	포커스가 없고 다른 modifier 가 없을 때만 가로채(평소 '/' 입력을 방해하지 않기 위해).
	xl 이상이면 헤더 검색폼(#header-search-input)에, /search 페이지면 SiteSearch 의
	#search-input 에 포커스하고, 둘 다 없으면 /search 로 이동한다.
*/}
<script is:inline>
	document.addEventListener('keydown', function (event) {
		var isCommandK = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
		var isSlash = event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey;
		if (!isCommandK && !isSlash) return;

		var target = event.target;
		var isEditing =
			target &&
			(target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
		if (isSlash && isEditing) return;

		event.preventDefault();

		var headerInput = document.getElementById('header-search-input');
		if (headerInput && headerInput.offsetParent !== null) {
			headerInput.focus();
			return;
		}
		var pageInput = document.getElementById('search-input');
		if (pageInput) {
			pageInput.focus();
			return;
		}
		window.location.href = '/search';
	});
</script>

{/*
	D-day 칩 계산. `@lib/dday.ts` 의 computeNearestEvent 와 같은 로직을 손으로 다시 적었다 —
	is:inline 스크립트는 번들러를 거치지 않아 모듈을 import 할 수 없기 때문이다(위 주석 참고).
	이 파일을 고치면 `src/lib/dday.ts` 도 함께 고칠 것.
*/}
<script is:inline>
	(function () {
		var dataEl = document.getElementById('dday-chip-events');
		var chip = document.getElementById('dday-chip');
		if (!dataEl || !chip) return;

		var events;
		try {
			events = JSON.parse(dataEl.textContent || '[]');
		} catch {
			return;
		}

		var ISO_DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
		var today = new Date();
		today.setHours(0, 0, 0, 0);

		var nearest = null;
		for (var i = 0; i < events.length; i++) {
			var event = events[i];
			if (!ISO_DATE_RE.test(event.date)) continue;
			var eventDate = new Date(event.date + 'T00:00:00');
			var diffDays = Math.round((eventDate.getTime() - today.getTime()) / 86400000);
			if (diffDays < 0) continue;
			if (nearest === null || diffDays < nearest.diffDays) {
				nearest = { label: event.label, date: event.date, status: event.status, diffDays: diffDays };
			}
		}
		if (!nearest) return;

		var badge = chip.querySelector('.dday-chip-badge');
		var label = chip.querySelector('.dday-chip-label');
		if (badge) {
			badge.textContent = nearest.diffDays === 0 ? 'D-DAY' : 'D-' + nearest.diffDays;
			if (nearest.status === '확정') {
				badge.classList.remove('bg-amber-100', 'text-amber-800', 'ring-amber-300');
				badge.classList.add('bg-emerald-100', 'text-emerald-800', 'ring-emerald-300');
			}
		}
		if (label) label.textContent = nearest.label;
	})();
</script>
