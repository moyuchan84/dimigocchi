---
/**
 * 오답노트 (UC-04). 영역별 요약과 목록은 React 아일랜드(WrongNoteList)가
 * localStorage 의 응시 기록에서 파생해 렌더한다 — 별도 저장소가 없다.
 */
import PageHeader from '@components/astro/PageHeader.astro';
import WrongNoteList from '@components/react/WrongNoteList';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';
import { listAllExamQuestions } from '@lib/taxonomy';

const breadcrumbs: Crumb[] = [{ label: '홈', href: '/' }, { label: '오답노트' }];

const allQuestions = await listAllExamQuestions();
---

<BaseLayout
	title="오답노트"
	description="모의고사에서 틀린 문항을 영역별로 모아 다시 풀어봅니다."
	breadcrumbs={breadcrumbs}
>
	<PageHeader title="오답노트" description="모의고사에서 틀린 문항을 모아 다시 풀어봅니다." />

	<WrongNoteList client:load allQuestions={allQuestions} />
</BaseLayout>
