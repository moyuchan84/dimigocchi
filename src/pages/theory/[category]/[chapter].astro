---
/**
 * 이론 챕터 상세 (UC-02 / FR-2).
 *
 * P2: 마크다운 본문을 Content Collections 에서 렌더한다.
 * `getStaticPaths` 가 **엔트리 자체**를 props 로 넘겨야 `render(entry)` 를 쓸 수 있으므로,
 * 여기서는 taxonomy 의 list* 대신 `getCollection('theory')` 를 직접 호출한다.
 * (taxonomy 는 라우트에 노출되는 카테고리/소분류 IA 인 THEORY_CATEGORIES 만 제공한다.)
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import PageHeader from '@components/astro/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';
import { THEORY_CATEGORIES } from '@lib/taxonomy';

export const getStaticPaths = (async () => {
	const entries = await getCollection('theory');

	return entries
		.sort((a, b) => a.data.order - b.data.order)
		.map((entry) => ({
			// 라우트 세그먼트는 frontmatter 값이 소유한다 — 파일이 놓인 경로와 무관하게 URL 이 고정된다.
			params: { category: entry.data.category, chapter: entry.data.id },
			props: { entry },
		}));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const chapter = entry.data;
const { Content } = await render(entry);

const category = THEORY_CATEGORIES.find((c) => c.slug === chapter.category);
if (!category) {
	throw new Error(`알 수 없는 이론 카테고리: ${chapter.category}`);
}

const subcategory = category.subcategories.find((s) => s.slug === chapter.subcategory);
if (!subcategory) {
	throw new Error(`알 수 없는 이론 소분류: ${chapter.subcategory}`);
}

/** 이전/다음 챕터와 형제 챕터 계산용 — 컬렉션 조회는 위 getStaticPaths 와 별개로 이 한 번뿐이다. */
const allChapters = (await getCollection('theory')).map((e) => e.data);

/** 같은 카테고리 안에서 order 오름차순으로 세운 뒤 현재 위치의 앞/뒤를 집는다. */
const siblings = allChapters
	.filter((c) => c.category === chapter.category)
	.sort((a, b) => a.order - b.order);
const currentIndex = siblings.findIndex((c) => c.id === chapter.id);
const prevChapter = currentIndex > 0 ? siblings[currentIndex - 1] : undefined;
const nextChapter = currentIndex >= 0 ? siblings[currentIndex + 1] : undefined;

/** 같은 소분류의 형제 챕터(현재 챕터 제외). P2 콘텐츠에서는 소분류당 1개라 항상 비어 있다. */
const sameSubcategory = allChapters.filter(
	(c) => c.category === chapter.category && c.subcategory === chapter.subcategory && c.id !== chapter.id,
);

const breadcrumbs: Crumb[] = [
	{ label: '홈', href: '/' },
	{ label: '이론 학습', href: '/theory' },
	// /theory/[category] 라우트는 사이트맵에 없다 → 목록 페이지의 카테고리 섹션 앵커로 보낸다.
	{ label: category.title, href: `/theory#${category.slug}` },
	{ label: chapter.title },
];
---

<BaseLayout
	title={chapter.title}
	description={`${category.title} · ${subcategory.title} 이론 챕터입니다.`}
	breadcrumbs={breadcrumbs}
>
	<PageHeader eyebrow={subcategory.title} title={chapter.title} />

	<section aria-labelledby="chapter-meta-heading">
		<h2 id="chapter-meta-heading" class="text-lg font-bold tracking-tight text-slate-900">
			챕터 정보
		</h2>
		<dl class="mt-3 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-3">
			<div>
				<dt class="text-xs font-semibold text-slate-500">예상 학습 시간</dt>
				<dd class="mt-1 text-sm text-slate-900">{chapter.estMinutes}분</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold text-slate-500">소분류</dt>
				<dd class="mt-1 text-sm text-slate-900">{subcategory.title}</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold text-slate-500">챕터 ID</dt>
				<dd class="mt-1 font-mono text-sm break-all text-slate-900">{chapter.id}</dd>
			</div>
		</dl>
	</section>

	<section class="mt-8" aria-labelledby="sibling-heading">
		<h2 id="sibling-heading" class="text-lg font-bold tracking-tight text-slate-900">
			{subcategory.title}의 다른 챕터
		</h2>
		{
			sameSubcategory.length > 0 ? (
				<ul class="mt-3 space-y-2">
					{sameSubcategory.map((sibling) => (
						<li>
							<a
								href={`/theory/${sibling.category}/${sibling.id}`}
								class="block rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-900 transition hover:border-brand-300 hover:text-brand-700"
							>
								{sibling.title}
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="mt-3 rounded-lg border border-slate-200 bg-white p-4 text-sm leading-relaxed text-slate-600">
					이 소분류의 챕터는 아직 1개뿐입니다. 나머지 챕터는 P7 에서 순차적으로 추가됩니다.
				</p>
			)
		}
	</section>

	{/*
		마크다운 본문. max-w-none 이 없으면 prose 기본 65ch 제한이 BaseLayout 의 max-w-4xl 안에서
		한 번 더 걸려 본문이 불필요하게 좁아진다.
		overflow-x-auto 는 본문 안의 GFM 표가 360px 뷰포트를 넘칠 때 페이지 전체가 아니라
		이 블록만 가로 스크롤되게 하려는 것이다(global.css 의 `.prose table { width: 100% }` 주석 참고).
	*/}
	<div class="mt-8 overflow-x-auto">
		<article class="prose prose-slate max-w-none">
			<Content />
		</article>
	</div>

	{
		(prevChapter || nextChapter) && (
			<nav class="mt-10 border-t border-slate-200 pt-6" aria-label="챕터 이동">
				<ul class="grid list-none gap-3 sm:grid-cols-2">
					{prevChapter && (
						<li>
							<a
								href={`/theory/${prevChapter.category}/${prevChapter.id}`}
								class="group flex h-full flex-col rounded-lg border border-slate-200 bg-white p-4 transition hover:border-brand-300 hover:shadow-sm"
							>
								<span class="text-xs font-semibold text-brand-700">← 이전 챕터</span>
								<span class="mt-1 font-medium text-slate-900 group-hover:text-brand-700">
									{prevChapter.title}
								</span>
							</a>
						</li>
					)}
					{nextChapter && (
						<li class="sm:col-start-2">
							<a
								href={`/theory/${nextChapter.category}/${nextChapter.id}`}
								class="group flex h-full flex-col rounded-lg border border-slate-200 bg-white p-4 text-right transition hover:border-brand-300 hover:shadow-sm"
							>
								<span class="text-xs font-semibold text-brand-700">다음 챕터 →</span>
								<span class="mt-1 font-medium text-slate-900 group-hover:text-brand-700">
									{nextChapter.title}
								</span>
							</a>
						</li>
					)}
				</ul>
			</nav>
		)
	}
</BaseLayout>
