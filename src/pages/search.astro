---
/**
 * 통합 검색 (UC-08 / FR-8.1 ~ FR-8.2).
 *
 * 검색 로직·입력창·검색 대상 안내를 전부 SiteSearch(React 아일랜드)가 소유한다.
 * 인덱스(`/search-index.json`)를 클라이언트에서 fetch 하는 순간부터 문서 수(검색 대상 카드의
 * "N개 문서")까지 그 응답에서 파생하므로, 이 astro 페이지는 taxonomy 를 직접 조회하지 않는다.
 */
import SiteSearch from '@components/react/SiteSearch';
import PageHeader from '@components/astro/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';

const breadcrumbs: Crumb[] = [{ label: '홈', href: '/' }, { label: '검색' }];
---

<BaseLayout
	title="통합 검색"
	description="이론 챕터, 모의고사 문항, 면접 질문을 한 번에 찾습니다."
	breadcrumbs={breadcrumbs}
>
	<PageHeader
		title="통합 검색"
		description="이론 챕터, 모의고사 문항, 면접 질문을 한 번에 찾습니다. 검색어는 이 브라우저 안에서만 처리되고 서버로 전송되지 않습니다."
	/>

	<SiteSearch client:load />
</BaseLayout>
