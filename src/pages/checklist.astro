---
/**
 * 준비 체크리스트 (UC-07 / FR-7.1 ~ FR-7.2).
 *
 * 항목 출처: `디미고_입시_준비_가이드.md` 8장(준비 시기와 포인트) · 9장(체크리스트).
 * 항목 데이터(단계/문구/id)는 `@lib/checklist` 가 유일한 소스다 — 홈 대시보드(Dashboard.tsx)도
 * 같은 id 목록으로 진행률 분모를 계산하므로 여기서 다시 정의하지 않는다.
 *
 * 체크박스 상태는 ChecklistBoard(React 아일랜드)가 `dimigo-prep:progress.checklist` 에서
 * 읽고 쓴다 — 정적 마크업은 요약 문구와 배지 설명까지만이다.
 */
import ChecklistBoard from '@components/react/ChecklistBoard';
import Badge from '@components/astro/Badge.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { CHECKLIST_STAGES } from '@lib/checklist';
import type { Crumb } from '@lib/navigation';

const breadcrumbs: Crumb[] = [{ label: '홈', href: '/' }, { label: '준비 체크리스트' }];
---

<BaseLayout
	title="준비 체크리스트"
	description="디미고 입시 준비를 단계별로 점검하는 체크리스트입니다."
	breadcrumbs={breadcrumbs}
>
	<PageHeader
		title="준비 체크리스트"
		description="원서 접수부터 면접까지 빠뜨리기 쉬운 항목을 단계별로 점검합니다."
	/>

	<p class="text-sm leading-relaxed text-slate-600">
		<Badge variant="tentative">예정(가안)</Badge> 배지가 붙은 항목은 2027학년도 전형요항이 확정되면 내용이
		바뀔 수 있어요. 체크 상태는 이 브라우저에만 저장됩니다.
	</p>

	<div class="mt-6">
		<ChecklistBoard client:load stages={CHECKLIST_STAGES} />
	</div>
</BaseLayout>
