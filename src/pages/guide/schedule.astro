---
/**
 * 전형 일정 · D-day (UC-06 / FR-6.1 ~ FR-6.3).
 *
 * P2: 일정 데이터를 코드에서 분리했다. 소스는 `src/content/schedule/2027.json` 하나뿐이며
 * (`year, confirmed, checkedAt, events[{label, date, status, note?}]`),
 * 확정 요강이 발표되면 **JSON 만 교체**하면 이 페이지는 그대로 따라간다(FR-10.1 / NFR-7).
 * `confirmed: true` 로 바뀌면 "예정(가안)" 배지가 확정 표기로 자동 전환된다.
 *
 * P5: D-day 계산은 DdayWidget(React 아일랜드, 홈과 공유)이 맡는다. 지금은 모든 이벤트의
 * date 가 "미정" 이라 계산 결과가 항상 없음(null)이며, 확정 날짜가 JSON 에 채워지는 순간부터
 * 코드 변경 없이 D-day 가 표시된다.
 */
import { getEntry } from 'astro:content';

import DdayWidget from '@components/react/DdayWidget';
import Badge from '@components/astro/Badge.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';

const breadcrumbs: Crumb[] = [
	{ label: '홈', href: '/' },
	{ label: '입시 가이드', href: '/guide' },
	{ label: '전형 일정' },
];

/** 대상 학년도. 다음 학년도 일정을 추가할 때는 JSON 파일과 이 상수만 바꾼다. */
const SCHEDULE_YEAR = '2027';

const schedule = await getEntry('schedule', SCHEDULE_YEAR);
if (!schedule) {
	throw new Error(`전형 일정 데이터를 찾을 수 없습니다: src/content/schedule/${SCHEDULE_YEAR}.json`);
}

const { year, confirmed, checkedAt, events } = schedule.data;

/** 아직 날짜가 확정되지 않은 단계 수 — 안내 문구를 데이터에 맞춰 쓰기 위한 값이다. */
const pendingCount = events.filter((event) => event.status === '예정').length;
---

<BaseLayout
	title="전형 일정 · D-day"
	description={`${year}학년도 한국디지털미디어고 입학 전형 일정과 남은 기간을 확인합니다.`}
	breadcrumbs={breadcrumbs}
>
	<PageHeader
		eyebrow="UC-06"
		title="전형 일정 · D-day"
		description={`${year}학년도 한국디지털미디어고 입학 전형 일정입니다.`}
	/>

	{/* 핵심 원칙 4 — 요강이 확정되기 전에는 반드시 "예정(가안)" 을 명시한다. */}
	{
		confirmed ? (
			<div class="mb-8 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-4 sm:p-5">
				<Badge variant="confirmed" size="md">
					확정
				</Badge>
				<p class="mt-2 text-sm leading-relaxed font-semibold text-emerald-900 sm:text-base">
					{year}학년도 신입생전형요항으로 확정된 일정입니다.
				</p>
				<p class="mt-2 text-sm text-emerald-900">
					확인 시점: {checkedAt} · 세부 사항은 학교 공식 사이트의 &ldquo;신입생전형요항&rdquo; 에서 다시
					확인하세요.
				</p>
			</div>
		) : (
			<div class="mb-8 rounded-lg border-2 border-amber-300 bg-amber-50 p-4 sm:p-5">
				<Badge variant="tentative" size="md">
					예정(가안)
				</Badge>
				<p class="mt-2 text-sm leading-relaxed font-semibold text-amber-900 sm:text-base">
					{year}학년도 요강은 아직 발표되지 않았습니다. 아래 일정은 최근 연도 기준 추정이며 확정 시 전면
					갱신됩니다.
				</p>
				<p class="mt-2 text-sm text-amber-900">
					확인 시점: {checkedAt} · 확정 요강은 학교 공식 사이트의 &ldquo;신입생전형요항&rdquo; 에서
					확인하세요.
				</p>
			</div>
		)
	}

	<section aria-labelledby="dday-heading" class="mb-10">
		<h2 id="dday-heading" class="text-lg font-semibold text-slate-900 sm:text-xl">D-day</h2>
		<div class="mt-3">
			<DdayWidget client:load events={events} />
		</div>
	</section>

	<section aria-labelledby="schedule-heading" class="mb-10">
		<h2 id="schedule-heading" class="text-lg font-semibold text-slate-900 sm:text-xl">전형 단계별 일정</h2>
		<p class="mt-2 text-sm leading-relaxed text-slate-600">
			총 {events.length}개 단계입니다.{
				pendingCount > 0 && ` 이 중 ${pendingCount}개 단계는 날짜가 확정되지 않아 “미정” 으로 표시됩니다.`
			}
		</p>

		<div class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white">
			<table class="w-full min-w-[36rem] border-collapse text-left text-sm">
				<caption class="sr-only">
					{year}학년도 한국디지털미디어고 전형 단계별 일정
				</caption>
				<thead class="bg-slate-100 text-slate-700">
					<tr>
						<th scope="col" class="px-4 py-3 font-semibold">단계</th>
						<th scope="col" class="px-4 py-3 font-semibold">일정</th>
						<th scope="col" class="px-4 py-3 font-semibold">상태</th>
					</tr>
				</thead>
				<tbody>
					{
						events.map((event) => (
							<tr class="border-t border-slate-200 align-top">
								<th scope="row" class="px-4 py-3 font-semibold text-slate-900">
									{event.label}
									{event.note && (
										<span class="mt-1 block text-xs leading-relaxed font-normal text-slate-600">
											{event.note}
										</span>
									)}
								</th>
								<td class="px-4 py-3 whitespace-nowrap text-slate-600">{event.date}</td>
								<td class="px-4 py-3">
									<Badge variant={event.status === '확정' ? 'confirmed' : 'tentative'}>
										{event.status}
									</Badge>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>
</BaseLayout>
