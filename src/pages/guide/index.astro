---
/**
 * 입시 가이드 (UC-09 / FR-9.1 ~ FR-9.2).
 *
 * P2: 저장소 루트의 `디미고_입시_준비_가이드.md` 를 Content Collections(`src/content/guide/`)
 * 마크다운 10개로 이식했다. 이 페이지는 그 10개를 order 순서대로 **한 페이지에 전부** 렌더한다.
 * (사이트맵에 `/guide/[section]` 라우트가 없다 — 각 절은 `#{id}` 앵커로만 접근한다.)
 *
 * ── 설계 메모 ──
 * 1. 섹션 목록/요약은 코드가 아니라 frontmatter(id/title/order/summary)가 소유한다.
 *    가이드 내용을 고칠 때 이 파일을 건드릴 일이 없어야 한다(FR-10.1/10.2).
 * 2. 목차는 데스크톱(lg 이상) 좌측 sticky 열, 모바일은 본문 위 네이티브 `<details>` 접이식이다.
 *    현재 위치 하이라이팅(scrollspy)은 JS 가 필요하므로 하지 않는다 — 이 페이지의 JS 는 0 bytes 다.
 * 3. `<summary>` 에 `aria-expanded` 를 수동으로 붙이지 않는다(Header.astro 와 동일한 이유 —
 *    브라우저가 `<details>` 확장 상태를 네이티브로 노출하며, 수동 속성은 동기화가 깨진다).
 * 4. 마크다운 본문에는 h1 이 없다(콘텐츠 작성 규칙). h1 은 PageHeader 하나뿐이고,
 *    각 절 제목인 h2 는 이 페이지가 렌더한다. 그래서 md 본문은 h3(###)부터 시작한다.
 */
import { getCollection, getEntry, render } from 'astro:content';

import Badge from '@components/astro/Badge.astro';
import CardLink from '@components/astro/CardLink.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';

const breadcrumbs: Crumb[] = [{ label: '홈', href: '/' }, { label: '입시 가이드' }];

/**
 * 번호를 붙이지 않는 절.
 * 원문 가이드에서 "출처" 는 번호 없는 부록이라 목차·제목 모두 번호 없이 표기한다.
 */
const UNNUMBERED_SECTION_IDS = new Set(['sources']);

const entries = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);

/** 요강 확정 여부 배너용. `/guide/schedule` 이 이미 쓰는 것과 같은 소스(`schedule/2027.json`)를 공유한다. */
const schedule = await getEntry('schedule', '2027');

/**
 * 표시 번호는 order 값이 아니라 **번호가 붙는 절만 센 연번**이다.
 * (출처 절이 중간으로 옮겨가더라도 1..9 가 끊기지 않는다.)
 */
let visibleNumber = 0;
const numbered = entries.map((entry) => ({
	entry,
	number: UNNUMBERED_SECTION_IDS.has(entry.data.id) ? null : ++visibleNumber,
}));

const sections = await Promise.all(
	numbered.map(async ({ entry, number }) => ({
		data: entry.data,
		number,
		Content: (await render(entry)).Content,
	})),
);

/** 목차 링크 라벨 — "3. 전형 종류" / 번호 없는 절은 "출처". */
const tocLabel = (number: number | null, title: string) => (number ? `${number}. ${title}` : title);
---

<BaseLayout
	title="입시 가이드"
	description="디미고 전형 구조와 준비 방법을 정리한 입시 가이드입니다."
	breadcrumbs={breadcrumbs}
	wide
>
	<PageHeader
		eyebrow="UC-09"
		title="입시 가이드"
		description="디미고 전형 구조와 준비 방법을 한 곳에 정리했습니다."
	/>

	{/* 핵심 원칙 4 — 확정 여부를 schedule/2027.json 하나로 판단해 배너·본문 문구가 서로 어긋나지 않게 한다. */}
	{
		schedule?.data.confirmed ? (
			<div class="mb-8 rounded-lg border-2 border-emerald-300 bg-emerald-50 p-4 sm:p-5">
				<Badge variant="confirmed">확정</Badge>
				<p class="mt-2 text-sm leading-relaxed text-emerald-900">
					{schedule.data.year}학년도 신입생 입학전형요항이 확정 발표되었습니다. 확인 시점:{' '}
					{schedule.data.checkedAt}. 세부 사항은 학교 공식 사이트의 "신입생전형요항" 원문에서 다시
					확인하세요.
				</p>
			</div>
		) : (
			<div class="mb-8 rounded-lg border border-amber-300 bg-amber-50 p-4 sm:p-5">
				<Badge variant="tentative">예정(가안)</Badge>
				<p class="mt-2 text-sm leading-relaxed text-amber-900">
					{schedule?.data.year ?? 2027}학년도 전형 요강은 확정 발표 전입니다. 아래 내용은 최근 연도
					기준 참고치이며, 확정 시 갱신됩니다. (조사 시점: {schedule?.data.checkedAt ?? '확인 필요'})
				</p>
			</div>
		)
	}

	{/*
		모바일 목차 — 본문 위 접이식. Header 의 드로어와 같은 무JS 패턴(<details>/<summary>)이며,
		lg 이상에서는 좌측 sticky 목차가 대신하므로 숨긴다.
	*/}
	<details class="mb-8 rounded-lg border border-slate-200 bg-white lg:hidden">
		<summary
			class="cursor-pointer list-none px-4 py-3 text-sm font-bold text-slate-900 [&::-webkit-details-marker]:hidden"
		>
			<span class="flex items-center justify-between gap-2">
				<span>가이드 목차 ({sections.length}개 항목)</span>
				<span aria-hidden="true" class="text-xs font-medium text-brand-700">열기/닫기</span>
			</span>
		</summary>
		<nav aria-label="가이드 목차" class="border-t border-slate-200 px-2 py-2">
			<ul class="space-y-0.5">
				{
					sections.map((section) => (
						<li>
							<a
								href={`#${section.data.id}`}
								class="block rounded-md px-2 py-2 text-sm leading-snug text-slate-700 hover:bg-slate-50 hover:text-brand-700"
							>
								{tocLabel(section.number, section.data.title)}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</details>

	{/*
		데스크톱 2단 — 좌측 sticky 목차(16rem 고정) + 우측 본문(minmax(0,1fr) 이라야
		본문 안의 넓은 표가 그리드 열을 밀어내지 않는다). items-start 가 있어야 sticky 가 동작한다.
	*/}
	<div class="lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:items-start lg:gap-10">
		<nav aria-label="가이드 목차" class="hidden lg:sticky lg:top-20 lg:block">
			<p class="px-3 text-xs font-bold tracking-wide text-slate-500 uppercase">가이드 목차</p>
			<ul class="mt-3 space-y-0.5 border-l border-slate-200">
				{
					sections.map((section) => (
						<li>
							<a
								href={`#${section.data.id}`}
								class="-ml-px block border-l-2 border-transparent py-1.5 pl-3 text-sm leading-snug text-slate-600 hover:border-brand-600 hover:text-brand-700"
							>
								{tocLabel(section.number, section.data.title)}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="space-y-10">
			{
				sections.map(({ data, number, Content }) => (
					<section id={data.id} class="scroll-mt-24 border-t border-slate-200 pt-8 first:border-t-0 first:pt-0">
						<h2 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
							{tocLabel(number, data.title)}
						</h2>
						<p class="mt-2 text-sm leading-relaxed text-slate-600">{data.summary}</p>

						{/*
							마크다운 본문. max-w-none 이 없으면 prose 기본 65ch 제한이 한 번 더 걸려 본문이 좁아진다.
							overflow-x-auto 는 본문 안의 GFM 표(특히 §4 평가 항목의 "비고" 열)가 좁은 화면을
							넘칠 때 **페이지 전체가 아니라 이 블록만** 가로 스크롤되게 한다
							(global.css 의 `.prose table { width: 100% }` 주석 참고 —
							가로 스크롤 래핑은 페이지 쪽 책임이다).
						*/}
						<div class="mt-4 overflow-x-auto">
							<div class="prose prose-slate max-w-none">
								<Content />
							</div>
						</div>
					</section>
				))
			}
		</div>
	</div>

	<section aria-labelledby="guide-related-heading" class="mt-12 border-t border-slate-200 pt-8">
		<h2 id="guide-related-heading" class="text-lg font-semibold text-slate-900 sm:text-xl">
			이어서 볼 페이지
		</h2>
		<p class="mt-2 text-sm leading-relaxed text-slate-600">
			가이드 본문 중 일부는 별도 페이지에서 더 자세히 다룹니다.
		</p>

		<div class="mt-4 grid gap-3 sm:grid-cols-2">
			<CardLink
				href="/checklist"
				title="준비 체크리스트"
				description="위 '체크리스트' 항목을 직접 체크하며 진행할 수 있는 페이지입니다."
				meta="UC-07"
				badge="체크"
			/>
			<CardLink
				href="/guide/schedule"
				title="전형 일정 · D-day"
				description="원서접수부터 최종 발표까지의 전형 일정과 남은 기간을 확인합니다."
				meta="UC-06"
				badge={schedule?.data.confirmed ? '확정' : '예정(가안)'}
				badgeVariant={schedule?.data.confirmed ? 'confirmed' : 'tentative'}
			/>
		</div>
	</section>
</BaseLayout>
