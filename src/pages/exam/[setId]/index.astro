---
/**
 * /exam/[setId] — 모의고사 응시 화면 (UC-03).
 *
 * 타이머·문항 렌더링·자동채점은 React 아일랜드(ExamRunner)가 담당한다.
 */
import type { GetStaticPaths } from 'astro';

import CardLink from '@components/astro/CardLink.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import ExamRunner from '@components/react/ExamRunner';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';
import { getExamQuestions, listExamSets } from '@lib/taxonomy';

export const getStaticPaths = (async () => {
	const sets = await listExamSets();
	return Promise.all(
		sets.map(async (set) => ({
			params: { setId: set.setId },
			props: { set, questions: (await getExamQuestions(set.setId)) ?? [] },
		})),
	);
}) satisfies GetStaticPaths;

const { set, questions } = Astro.props;

const breadcrumbs: Crumb[] = [
	{ label: '홈', href: '/' },
	{ label: '모의고사', href: '/exam' },
	{ label: set.title },
];
---

<BaseLayout
	title={set.title}
	description={`${set.areaTitle} 영역 예상문제 ${set.questionCount}문항, 제한시간 ${set.limitMinutes}분 모의고사 세트입니다.`}
	breadcrumbs={breadcrumbs}
	wide
>
	<PageHeader eyebrow={set.areaTitle} title={set.title} />

	<p class="mb-8 text-xs leading-relaxed text-slate-500">
		모든 문항은 자체 제작한 예상문제입니다. 실제 기출문제 원문은 게재하지 않습니다.
	</p>

	<section aria-labelledby="exam-brief">
		<h2 id="exam-brief" class="text-lg font-bold text-slate-900">응시 안내</h2>
		<div class="mt-4 rounded-lg border border-slate-200 bg-white p-5">
			<dl class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
				<div>
					<dt class="text-sm text-slate-500">문항 수</dt>
					<dd class="mt-1 font-semibold text-slate-900">{set.questionCount}문항</dd>
				</div>
				<div>
					<dt class="text-sm text-slate-500">제한 시간</dt>
					<dd class="mt-1 font-semibold text-slate-900">{set.limitMinutes}분</dd>
				</div>
				<div>
					<dt class="text-sm text-slate-500">채점 방식</dt>
					<dd class="mt-1 font-semibold text-slate-900">제출 즉시 자동채점</dd>
				</div>
				<div>
					<dt class="text-sm text-slate-500">저장 위치</dt>
					<dd class="mt-1 font-semibold text-slate-900">이 브라우저에만 저장</dd>
				</div>
				<div class="sm:col-span-2">
					<dt class="text-sm text-slate-500">출제 영역</dt>
					<dd class="mt-1 font-semibold text-slate-900">{set.areaTitle}</dd>
				</div>
			</dl>
		</div>
	</section>

	<section aria-labelledby="exam-runner" class="mt-10">
		<h2 id="exam-runner" class="text-lg font-bold text-slate-900">응시</h2>
		<div class="mt-4">
			<ExamRunner client:load setId={set.setId} limitMinutes={set.limitMinutes} questions={questions} />
		</div>
	</section>

	<section aria-labelledby="exam-links" class="mt-10">
		<h2 id="exam-links" class="text-lg font-bold text-slate-900">관련 화면</h2>
		<ul class="mt-4 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
			<li>
				<CardLink
					href={`/exam/${set.setId}/result`}
					title="지난 결과 보기"
					description="이전 응시 결과와 문항별 해설을 다시 볼 수 있어요."
					meta="채점 결과"
				/>
			</li>
			<li>
				<CardLink
					href="/exam"
					title="모의고사 목록으로"
					description="다른 영역의 예상문제 세트를 둘러봅니다."
					meta="9세트 · 5개 영역"
				/>
			</li>
		</ul>
	</section>
</BaseLayout>
