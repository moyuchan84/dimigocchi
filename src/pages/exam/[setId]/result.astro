---
/**
 * /exam/[setId]/result — 모의고사 결과·해설 화면 (UC-03 / FR-3.4).
 *
 * 점수/정답률/문항별 해설은 React 아일랜드(ExamResult)가 localStorage 의 응시 기록을
 * 읽어 렌더한다.
 */
import type { GetStaticPaths } from 'astro';

import CardLink from '@components/astro/CardLink.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import ExamResult from '@components/react/ExamResult';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';
import { getExamQuestions, listExamSets } from '@lib/taxonomy';

export const getStaticPaths = (async () => {
	const sets = await listExamSets();
	return Promise.all(
		sets.map(async (set) => ({
			params: { setId: set.setId },
			props: { set, questions: (await getExamQuestions(set.setId)) ?? [] },
		})),
	);
}) satisfies GetStaticPaths;

const { set, questions } = Astro.props;

const breadcrumbs: Crumb[] = [
	{ label: '홈', href: '/' },
	{ label: '모의고사', href: '/exam' },
	{ label: set.title, href: `/exam/${set.setId}` },
	{ label: '결과' },
];
---

<BaseLayout
	title={`${set.title} 결과`}
	description={`${set.title} 모의고사의 채점 결과와 문항별 해설이 표시되는 화면입니다.`}
	breadcrumbs={breadcrumbs}
	wide
>
	<PageHeader eyebrow={set.title} title="응시 결과" />

	<ExamResult client:load setId={set.setId} questions={questions} />

	<section aria-labelledby="next-actions" class="mt-10">
		<h2 id="next-actions" class="text-lg font-semibold text-slate-900">다음 단계</h2>
		<ul class="mt-4 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
			<li>
				<CardLink
					href="/exam"
					title="모의고사 목록으로"
					description="다른 영역의 예상문제 세트에 도전해 보세요."
					meta="9세트 · 5개 영역"
				/>
			</li>
		</ul>
	</section>
</BaseLayout>
