---
/**
 * /exam — 모의고사 세트 목록 (UC-03).
 *
 * 세트 메타데이터는 빌드 타임에 Content Collections 에서 읽는다.
 * "최근 결과"(FR-3.5)는 localStorage 의존이라 React 아일랜드(RecentResults)가 담당한다.
 */
import Badge from '@components/astro/Badge.astro';
import CardLink from '@components/astro/CardLink.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import RecentResults from '@components/react/RecentResults';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';
import { listExamSets, type ExamArea, type ExamSetRef } from '@lib/taxonomy';

const breadcrumbs: Crumb[] = [{ label: '홈', href: '/' }, { label: '모의고사' }];

const examSets = await listExamSets();

/** 정의 순서를 유지하면서 area 별로 5개 그룹으로 묶는다. */
const groups: { area: ExamArea; areaTitle: string; sets: ExamSetRef[] }[] = [];
for (const set of examSets) {
	const found = groups.find((g) => g.area === set.area);
	if (found) {
		found.sets.push(set);
	} else {
		groups.push({ area: set.area, areaTitle: set.areaTitle, sets: [set] });
	}
}

const totalQuestions = examSets.reduce((sum, set) => sum + set.questionCount, 0);
---

<BaseLayout
	title="모의고사"
	description="영역별 예상문제 세트로 실전 감각을 기르는 모의고사 화면입니다."
	breadcrumbs={breadcrumbs}
	wide
>
	<PageHeader
		eyebrow="UC-03"
		title="모의고사"
		description="영역별 예상문제 세트로 실전 감각을 기릅니다."
	/>

	<p class="mb-8 text-xs leading-relaxed text-slate-500">
		모든 문항은 자체 제작한 예상문제입니다. 실제 기출문제 원문은 게재하지 않습니다.
	</p>

	<div class="mb-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-600">
		<Badge variant="neutral" size="md">전체 {examSets.length}세트</Badge>
		<span>목표 문항 수 합계 {totalQuestions}문항 · 5개 영역</span>
	</div>

	<div class="space-y-10">
		{
			groups.map((group) => (
				<section aria-labelledby={`area-${group.area}`}>
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h2 id={`area-${group.area}`} class="text-lg font-semibold text-slate-900">
							{group.areaTitle}
						</h2>
						<span class="text-sm text-slate-500">{group.sets.length}세트</span>
					</div>
					<ul class="mt-4 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
						{group.sets.map((set) => (
							<li>
								<CardLink
									href={`/exam/${set.setId}`}
									title={set.title}
									meta={`${set.questionCount}문항 · 제한시간 ${set.limitMinutes}분`}
									badge={set.areaTitle}
								/>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>

	<section aria-labelledby="recent-results" class="mt-12">
		<h2 id="recent-results" class="text-lg font-semibold text-slate-900">최근 결과</h2>
		<div class="mt-4">
			<RecentResults client:load sets={examSets} />
		</div>
	</section>
</BaseLayout>
