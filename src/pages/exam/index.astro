---
/**
 * /exam — 모의고사 세트 목록 (UC-03).
 *
 * P1 에서는 세트 메타데이터(문항 수/제한 시간)만 렌더한다.
 * 응시 기록은 P3/P5 에서 localStorage(`dimigo-prep:progress.examResults`)로 다루므로,
 * 이 페이지는 저장소를 **읽지 않는다**.
 */
import Badge from '@components/astro/Badge.astro';
import CardLink from '@components/astro/CardLink.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import PlaceholderCard from '@components/astro/PlaceholderCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';
import { listExamSets, type ExamArea, type ExamSetRef } from '@lib/taxonomy';

const breadcrumbs: Crumb[] = [{ label: '홈', href: '/' }, { label: '모의고사' }];

// P2: listExamSets() 의 본문이 getCollection('exams') 로 바뀐다. 이 호출부는 수정 불필요.
const examSets = await listExamSets();

/** 정의 순서를 유지하면서 area 별로 5개 그룹으로 묶는다. */
const groups: { area: ExamArea; areaTitle: string; sets: ExamSetRef[] }[] = [];
for (const set of examSets) {
	const found = groups.find((g) => g.area === set.area);
	if (found) {
		found.sets.push(set);
	} else {
		groups.push({ area: set.area, areaTitle: set.areaTitle, sets: [set] });
	}
}

const totalQuestions = examSets.reduce((sum, set) => sum + set.questionCount, 0);
---

<BaseLayout
	title="모의고사"
	description="영역별 예상문제 세트로 실전 감각을 기르는 모의고사 화면입니다."
	breadcrumbs={breadcrumbs}
	wide
>
	<PageHeader
		eyebrow="UC-03"
		title="모의고사"
		description="영역별 예상문제 세트로 실전 감각을 기릅니다."
	/>

	<p class="mb-8 text-xs leading-relaxed text-slate-500">
		모든 문항은 자체 제작한 예상문제입니다. 실제 기출문제 원문은 게재하지 않습니다.
	</p>

	<div class="mb-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-600">
		<Badge variant="neutral" size="md">전체 {examSets.length}세트</Badge>
		<span>목표 문항 수 합계 {totalQuestions}문항 · 5개 영역</span>
	</div>

	<div class="space-y-10">
		{
			groups.map((group) => (
				<section aria-labelledby={`area-${group.area}`}>
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h2 id={`area-${group.area}`} class="text-lg font-bold text-slate-900">
							{group.areaTitle}
						</h2>
						<span class="text-sm text-slate-500">{group.sets.length}세트</span>
					</div>
					<ul class="mt-4 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
						{group.sets.map((set) => (
							<li>
								<CardLink
									href={`/exam/${set.setId}`}
									title={set.title}
									meta={`${set.questionCount}문항 · 제한시간 ${set.limitMinutes}분`}
									badge={set.areaTitle}
								/>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>

	<section aria-labelledby="recent-results" class="mt-12">
		<h2 id="recent-results" class="text-lg font-bold text-slate-900">최근 결과</h2>
		<div class="mt-4 rounded-lg border border-slate-200 bg-white p-5">
			<p class="text-sm text-slate-600">아직 응시 기록이 없습니다.</p>
			<p class="mt-2 text-sm leading-relaxed text-slate-600">
				응시를 마치면 세트별 점수와 영역별 정답률이 이 자리에 쌓입니다. 틀린 문항은 자동으로
				오답노트로 모입니다.
			</p>
			<p class="mt-3 text-sm">
				<a class="font-semibold text-brand-700 underline underline-offset-2" href="/wrongnote">
					오답노트 보기
				</a>
			</p>
		</div>
	</section>

	<div class="mt-10">
		<PlaceholderCard phase="P3" uc="UC-03" fr="FR-3.1 ~ FR-3.6">
			<p>
				P3 에서 문제은행 JSON 을 읽어 세트별 응시 화면과 자동 채점 엔진을 구현합니다. 세트를
				고르면 타이머가 있는 응시 화면으로 이동하고, 제출 즉시 채점 결과가 나옵니다.
			</p>
			<p>
				응시 기록은 이 브라우저의 <code>localStorage</code> 에만 저장되며 서버로 전송되지 않습니다.
			</p>
		</PlaceholderCard>
	</div>
</BaseLayout>
