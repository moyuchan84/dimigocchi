---
/**
 * 면접 카테고리별 질문 목록 + 답변 작성 화면 (UC-05).
 *
 * P1 에서는 질문 데이터가 없으므로 질문 카드가 어떤 형태가 될지 스켈레톤 1개로만 보여준다.
 * 동작하지 않는 입력(textarea/input)은 렌더하지 않는다 — 실제 답변 작성은 P4 영역이다.
 */
import type { GetStaticPaths } from 'astro';

import Badge from '@components/astro/Badge.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import PlaceholderCard from '@components/astro/PlaceholderCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Crumb } from '@lib/navigation';
import { listInterviewCategories, type InterviewCategorySlug } from '@lib/taxonomy';

export const getStaticPaths = (async () => {
	// P2 교체 지점: listInterviewCategories() 의 본문이 getCollection('interview') 로 바뀐다.
	// 이 파일은 시그니처에만 의존하므로 수정할 필요가 없다.
	const categories = await listInterviewCategories();
	return categories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}) satisfies GetStaticPaths;

const { category } = Astro.props;

/** 카테고리별 준비 관점 한 줄. 질문 데이터(P4/P7)와 달리 화면 안내 문구이므로 페이지에 둔다. */
const PREP_NOTE: Record<InterviewCategorySlug, string> = {
	motivation: '학교 홈페이지에서 확인한 사실과 내 경험을 한 문장으로 잇는 연습을 합니다.',
	portfolio: '결과물의 목적 → 내가 맡은 일 → 어려웠던 점 → 배운 점 순서로 정리합니다.',
	career: '보안 분야의 직무 이름을 외우기보다, 그 일이 무엇을 지키는 일인지 설명합니다.',
	personality: '잘한 일보다 실패와 갈등을 어떻게 다뤘는지가 더 자주 질문됩니다.',
	'security-news':
		'사건의 원인과 피해, 그리고 개인·기업·사회가 무엇을 바꿔야 하는지를 근거와 함께 말합니다. 공격 방법을 설명하는 자리가 아니라, 왜 문제인지와 어떻게 예방·대응할지에 대한 생각을 묻는 자리입니다.',
};

/** 카테고리별로 다른 앵커 대신, 스켈레톤 안내 문구를 한 벌만 쓴다. */
const SKELETON_ROWS: readonly { label: string; hint: string }[] = [
	{ label: '질문', hint: '면접관이 실제로 물을 법한 예상 질문 한 문장이 들어갑니다.' },
	{ label: '질문 의도', hint: '이 질문으로 무엇을 확인하려는지 설명이 들어갑니다.' },
	{ label: '답변 가이드', hint: '어떤 순서로 무엇을 담아야 하는지 뼈대가 들어갑니다.' },
	{ label: '내 답변', hint: '내가 직접 쓴 답변 초안이 들어갑니다. 브라우저에만 저장됩니다.' },
];

const others = (await listInterviewCategories()).filter((c) => c.slug !== category.slug);

const breadcrumbs: Crumb[] = [
	{ label: '홈', href: '/' },
	{ label: '면접 준비', href: '/interview' },
	{ label: category.title },
];
---

<BaseLayout title={`${category.title} · 면접 준비`} description={category.description} breadcrumbs={breadcrumbs}>
	<PageHeader eyebrow="면접 준비" title={category.title} description={category.description} />

	<section aria-labelledby="questions-heading" class="mb-10">
		<div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
			<h2 id="questions-heading" class="text-lg font-semibold text-slate-900">예상 질문</h2>
			<Badge variant="neutral">목표 {category.targetCount}문항 · 현재 0문항 등록</Badge>
		</div>
		<p class="mb-4 max-w-2xl text-sm leading-relaxed text-slate-600">{PREP_NOTE[category.slug]}</p>

		<div class="rounded-lg border border-slate-200 bg-white p-4 sm:p-5">
			<p class="mb-4 text-sm text-slate-500">질문 카드 1개의 예시 구조입니다. 실제 내용은 P4 에서 채워집니다.</p>
			<ol class="list-none space-y-4">
				{
					SKELETON_ROWS.map((row) => (
						<li>
							<p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{row.label}</p>
							<div class="mt-1.5 rounded-md bg-slate-100 px-3 py-2.5">
								<div class="h-2.5 w-full rounded-full bg-slate-200"></div>
								<div class="mt-2 h-2.5 w-4/5 rounded-full bg-slate-200"></div>
								<p class="mt-2 text-xs leading-relaxed text-slate-500">{row.hint}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section aria-labelledby="others-heading" class="mb-10">
		<h2 id="others-heading" class="mb-3 text-lg font-semibold text-slate-900">다른 카테고리</h2>
		<ul class="flex list-none flex-wrap gap-2">
			{
				others.map((other) => (
					<li>
						<a
							href={`/interview/${other.slug}`}
							class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 transition hover:border-brand-300 hover:text-brand-700"
						>
							{other.title}
							<span class="text-xs text-slate-500">{other.targetCount}문항</span>
						</a>
					</li>
				))
			}
			<li>
				<a
					href="/interview/timeattack"
					class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 transition hover:border-brand-300 hover:text-brand-700"
				>
					타임어택
					<span class="text-xs text-slate-500">실전</span>
				</a>
			</li>
		</ul>
	</section>

	<PlaceholderCard phase="P4" uc="UC-05" fr="FR-5.1 ~ FR-5.3">
		<p>
			P4 에서 <code>src/content/interview/</code> 의 JSON(<code>id</code>, <code>category</code>,
			<code>question</code>, <code>intent</code>, <code>answerGuide</code>)을 읽어 이 자리에 질문 카드를
			목록으로 렌더합니다.
		</p>
		<p>
			각 질문에 쓴 답변 초안은 <code>dimigo-prep:progress.interviewAnswers</code> 에 저장되어 다음에 다시
			열어도 남아 있습니다. 저장 위치는 이 브라우저의 localStorage 뿐이며 서버로 전송되지 않습니다.
		</p>
	</PlaceholderCard>
</BaseLayout>
