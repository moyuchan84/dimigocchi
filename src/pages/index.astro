---
/**
 * 홈 대시보드 (UC-01 / FR-1.1 ~ FR-1.4).
 *
 * 진행률 4+1종(적성검사 이론/해킹방어 이론/모의고사/면접/체크리스트) · 추천 학습 ·
 * 최근 오답 요약은 Dashboard(React 아일랜드)가 `dimigo-prep:progress` 를 읽어 채운다.
 * D-day 는 DdayWidget(전형 일정 페이지와 공유)이 담당한다. 이 astro 페이지는 각 아일랜드에
 * 필요한 정적 콘텐츠 목록(챕터/세트/문항/체크리스트 항목)만 조회해 props 로 넘긴다.
 */
import Dashboard from '@components/react/Dashboard';
import DdayWidget from '@components/react/DdayWidget';
import Badge from '@components/astro/Badge.astro';
import PageHeader from '@components/astro/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { listChecklistItemIds } from '@lib/checklist';
import { SITE_NAME } from '@lib/navigation';
import {
	THEORY_CATEGORIES,
	listAllExamQuestions,
	listAllInterviewQuestions,
	listExamSets,
	listTheoryChapters,
} from '@lib/taxonomy';

const chapters = await listTheoryChapters();

/** 추천 카드/진행률 카드에 쓸 카테고리·소분류 한글 라벨 조회표. */
const categoryTitle = new Map(THEORY_CATEGORIES.map((c) => [c.slug, c.title] as const));
const subcategoryTitle = new Map(
	THEORY_CATEGORIES.flatMap((c) => c.subcategories.map((s) => [s.slug, s.title] as const)),
);

/** Dashboard(React) 는 Map 을 props 로 받을 수 없으므로(직렬화 대상) 챕터별로 라벨을 미리 박아 넘긴다. */
const dashboardChapters = chapters.map((c) => ({
	id: c.id,
	category: c.category,
	title: c.title,
	categoryTitle: categoryTitle.get(c.category) ?? c.category,
	subcategoryTitle: subcategoryTitle.get(c.subcategory) ?? c.subcategory,
	estMinutes: c.estMinutes,
}));

const examSets = await listExamSets();
const allExamQuestions = await listAllExamQuestions();
const interviewQuestionIds = (await listAllInterviewQuestions()).map((q) => q.id);
const checklistItemIds = listChecklistItemIds();

const SCHEDULE_YEAR = '2027';
const schedule = await getEntry('schedule', SCHEDULE_YEAR);
if (!schedule) {
	throw new Error(`전형 일정 데이터를 찾을 수 없습니다: src/content/schedule/${SCHEDULE_YEAR}.json`);
}
const { confirmed, events } = schedule.data;
---

<BaseLayout title={SITE_NAME} wide>
	<PageHeader
		eyebrow="2027학년도 대비"
		title="디미고 해킹방어과 입시 준비"
		description="적성검사 대비 이론, 해킹방어과 특화 기초, 모의고사와 면접 준비를 한곳에 모았습니다. 오늘 할 일을 확인하고 이어서 학습하세요."
	/>

	<Dashboard
		client:load
		chapters={dashboardChapters}
		examSetCount={examSets.length}
		allExamQuestions={allExamQuestions}
		interviewQuestionIds={interviewQuestionIds}
		checklistItemIds={checklistItemIds}
	/>

	<section aria-labelledby="dday-heading" class="mt-10">
		<h2 id="dday-heading" class="text-lg font-semibold text-slate-900">전형 일정 D-day</h2>
		<div class="mt-4 space-y-3">
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
				<Badge variant={confirmed ? 'confirmed' : 'tentative'}>{confirmed ? '확정' : '예정(가안)'}</Badge>
				<span class="text-sm text-slate-600">
					2027학년도 전형 일정{!confirmed && ' — 아직 확정 요강이 발표되지 않았습니다'}
				</span>
			</div>
			<DdayWidget client:load events={events} />
			<p>
				<a
					href="/guide/schedule"
					class="text-sm font-semibold text-brand-700 underline underline-offset-4 hover:no-underline"
				>
					전형 일정 자세히 보기
				</a>
			</p>
		</div>
	</section>

	<p class="mt-10 text-xs text-slate-500">학습 기록은 서버로 전송되지 않고 이 브라우저에만 저장됩니다.</p>
</BaseLayout>
